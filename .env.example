# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Needed only by scripts (admin provisioning, demo seed/reset) and Auth admin operations.
SUPABASE_SERVICE_ROLE_KEY=
# Environment guard used by demo reset: local | demo | production
JADARAH_ENV=local

# Initial Super Admin (used by `npm run admin:provision`; never commit real values)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Demo identities share one password supplied at seed time (never committed)
DEMO_USER_PASSWORD=

# AI providers (optional; without them the app runs in clearly-labelled rule-based mode)
AI_PROVIDER=gemini            # gemini | openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=25000
