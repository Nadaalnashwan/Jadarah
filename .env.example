# JADARAH — environment variables. Copy to .env.local and fill in. Never commit real values.
# Names only: no secret in this file is real.

# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Needed only by scripts (admin provisioning, demo seed/reset, imports, local E2E fixtures). Not needed by the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Environment guard used by demo reset: local | demo | production
JADARAH_ENV=local

# Initial Super Admin (used by `npm run admin:provision`; never commit real values)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Demo/test identities share one password supplied at seed time (never committed). Used by integration tests.
DEMO_USER_PASSWORD=

# Optional: privileged Postgres connection for scripts (demo seed/reset, cleanup, apply-migration) and local E2E fixtures
SUPABASE_DB_URL=

# ---- AI (server only). Without keys the app runs in clearly-labelled rule-based mode. ----
# Task routing: fast chat → Groq, structured extraction/generation → Gemini, deep evaluation → OpenAI.
# Verify model IDs against your keys first: npm run ai:verify
AI_PROVIDER=gemini
AI_TIMEOUT_MS=25000
AI_PRIMARY_TIMEOUT_MS=15000   # shorter budget for a primary model that has an approved backup
AI_STRICT_ROUTING=false       # true = never fall back to another provider
AI_DEBUG=                     # 1 = log provider error codes to the server console

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash   # approved backup on overload/timeout (owner decision 2026-11-11)
# AI_BUILDER_GEMINI_MODEL=gemini-3.5-flash-lite   # optional, Assessment Builder only (owner-approved temporary override)
GEMINI_THINKING_LEVEL=low                # Gemini 3 thinking level: low | medium | high | default
GEMINI_JSON_SCHEMA=                      # false = do not send a response JSON schema to Gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Embeddings for semantic matching (pgvector, 768 dims). Backfill: npm run ai:embed-skills && npm run ai:embed-profiles
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
SEMANTIC_RELATED_MIN=0.92

# Reference-library import only (scripts/import/import-references.ts)
IMPORT_GEMINI_MODEL=
VISION_PER_PAGE=

# ---- Server-only secrets (never NEXT_PUBLIC_) ----
JADARAH_SERVER_KEY=           # >= 32 chars; narrow key for internal_* RPCs (its SHA-256 is registered in the DB)
CRON_SECRET=                  # bearer secret for scheduled jobs (/api/internal/*)

# ---- Email delivery (optional; app works without it) ----
EMAIL_PROVIDER=               # smtp | (empty = disabled)
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=                  # true for implicit TLS (465)

# Legacy name accepted as a fallback for the publishable key (prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Daily.co video interviews (server only)
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=

# Resend — FUTURE WORK, lowest priority. Not integrated; leave empty.
RESEND_API_KEY=

# ---- Tests (local machine / CI only) ----
E2E_BASE_URL=                 # e.g. http://localhost:3100 (production build); default http://localhost:3000
PW_CHROMIUM_PATH=             # optional: use a preinstalled Chromium
RUN_LOCAL_E2E=                # 1 = run tests/e2e/core-journeys.spec.ts (requires a LOCAL Supabase in this file)
E2E_SHOTS_DIR=                # optional: where core-journeys saves screenshots
RUN_LIVE_AI=                  # 1 = run live AI specs (costs provider credits)
RUN_LIVE_VIDEO=               # 1 = run the live Daily video spec
BUILDER_ONLY=                 # limit builder-live spec, e.g. elm,sdaia
CAPTURE_EVIDENCE=             # 1 = capture docs/evidence screenshots
EVIDENCE_DIR=
E2E_EMAIL_TEST_ADDRESS=       # optional: real inbox used by auth email tests
E2E_EMAIL_TEST_PASSWORD=
