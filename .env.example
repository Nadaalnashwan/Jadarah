# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Needed only by scripts (admin provisioning, demo seed/reset) and Auth admin operations.
SUPABASE_SERVICE_ROLE_KEY=
# Environment guard used by demo reset: local | demo | production
JADARAH_ENV=local

# Initial Super Admin (used by `npm run admin:provision`; never commit real values)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Demo identities share one password supplied at seed time (never committed)
DEMO_USER_PASSWORD=

# Optional: privileged Postgres connection for demo seed/reset scripts only
SUPABASE_DB_URL=

# ---- AI (server only). Without keys the app runs in clearly-labelled rule-based mode. ----
# Task routing: fast chat → Groq, structured extraction/generation → Gemini, deep evaluation → OpenAI.
# Verify model IDs against your keys first: npm run ai:verify
AI_PROVIDER=gemini
AI_TIMEOUT_MS=25000
AI_PRIMARY_TIMEOUT_MS=15000   # shorter budget for a primary model that has an approved backup
AI_STRICT_ROUTING=false       # true = never fall back to another provider

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash   # approved backup on overload/timeout (owner decision 2026-11-11)
GEMINI_THINKING_LEVEL=low                # Gemini 3 thinking level: low | medium | high | default

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Embeddings for semantic matching (pgvector, 768 dims). Backfill: npm run ai:embed-skills && npm run ai:embed-profiles
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
SEMANTIC_RELATED_MIN=0.92

# Daily.co video interviews (server only)
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=

# Resend — FUTURE WORK, lowest priority. Not integrated; leave empty.
RESEND_API_KEY=
